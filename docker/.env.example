# Local overrides for docker/imscp. Copy to docker/.env, or run
# `docker/imscp init` to have the port block written for you with ports that
# are free on this machine.
#
# docker/.env is not tracked by git.

# One container per checkout. Defaults to imscp-<directory name>.
#COMPOSE_PROJECT_NAME=imscp-dev

# Debian release to install on. Must be one the autoinstaller knows about:
# see ../autoinstaller/Packages/debian-*.xml. bookworm (12) and trixie (13) are
# the current ones.
#DEBIAN_SUITE=bookworm

# i-MSCP refuses to install without a fully qualified host name. These two make
# up the container's FQDN, and the panel then lives at panel.<FQDN>.
#IMSCP_HOSTNAME_SHORT=imscp
#IMSCP_DOMAIN=docker.local

# The directory holding your plugin checkouts. It is mounted whole at
# /var/www/imscp-plugins. Defaults to the directory this repository sits in.
#IMSCP_PLUGINS_ROOT=/home/you/src

# Which checkouts in there to link into the panel as plugins, space separated,
# by directory name. Each is linked under the name it declares in its
# makefile.json, so imscp-php-version becomes
# /var/www/imscp/gui/plugins/SGW_PhpVersion. Changing this list only needs
# `docker/imscp link` — it does not touch the container.
#IMSCP_PLUGINS="imscp-php-version imscp-letsencrypt"

# Control panel credentials, used by docker/preseed.pl at install time.
# Changing them after the install has run has no effect.
#IMSCP_ADMIN_LOGIN=admin
#IMSCP_ADMIN_PASSWORD=imscp1234
#IMSCP_ADMIN_EMAIL=admin@example.com

# Published host ports. `docker/imscp init` fills these in with free ones.
#PANEL_HTTP_PORT=8880
#PANEL_HTTPS_PORT=8443
#HTTP_PORT=8080
#HTTPS_PORT=8444
#FTP_PORT=2121
#SMTP_PORT=2525
#SUBMISSION_PORT=5587
#IMAP_PORT=1143
#IMAPS_PORT=9993
#POP3_PORT=1110
#POP3S_PORT=9995
#DNS_PORT=15353

# FTP passive ports. Published unchanged on the host, because a passive port has
# to be reachable on the same number proftpd advertises — so unlike the ports
# above this one cannot simply be remapped.
#FTP_PASSIVE_PORTS=32768-32777

# The WAN IP written into DNS zones and the panel. Blank makes the installer
# look it up over the internet, as the Vagrant boxes do; set it to any
# public-range address if this machine cannot reach ipinfo.io.
#IMSCP_PUBLIC_IP=

# Install-time choices passed through to docker/preseed.pl. The defaults favour
# a fast install; raise them when you need the thing in question.
#IMSCP_PO_SERVER=dovecot                    # or courier
#IMSCP_TIMEZONE=UTC
#IMSCP_WEB_STATISTIC_PACKAGES=No            # or AWStats
#IMSCP_WEB_FTP_CLIENT_PACKAGES=No           # or MonstaFTP
#IMSCP_SQL_ADMIN_TOOL_PACKAGES=PhpMyAdmin   # or No
#IMSCP_WEB_MAIL_CLIENT_PACKAGES=No          # or RainLoop,Roundcube
#IMSCP_ANTI_ROOTKIT_PACKAGES=No             # or Chkrootkit,Rkhunter
#SQL_ROOT_PASSWORD=root
#DATABASE_PASSWORD=imscp1234
